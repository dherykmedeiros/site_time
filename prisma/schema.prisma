generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────

enum Role {
  ADMIN
  PLAYER
  COACH
  MATERIAL_DIRECTOR
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  LEFT_BACK
  RIGHT_BACK
  LEFT_WINGBACK
  RIGHT_WINGBACK
  MIDFIELDER
  DEFENSIVE_MIDFIELDER
  FORWARD
  LEFT_WINGER
  RIGHT_WINGER
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
}

enum AvailabilityFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY_OPTIONAL
}

enum AvailabilityLevel {
  AVAILABLE
  PREFERABLE
  UNAVAILABLE
}

enum MatchType {
  FRIENDLY
  CHAMPIONSHIP
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MatchLineupRole {
  STARTER
  BENCH
}

enum MatchLineupFormation {
  FOUR_FOUR_TWO
  FOUR_THREE_THREE
  FOUR_TWO_THREE_ONE
  THREE_FIVE_TWO
  THREE_FOUR_THREE
  FIVE_THREE_TWO
  FOUR_ONE_FOUR_ONE
  FIVE_FOUR_ONE
}

enum MatchLineupBlockPreset {
  DEEP
  BALANCED
  HIGH
}

enum RSVPStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum FriendlyRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  MEMBERSHIP
  FRIENDLY_FEE
  MATCH_FEE
  VENUE_RENTAL
  REFEREE
  EQUIPMENT
  OTHER
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AchievementType {
  HAT_TRICK
  TOP_SCORER_ROUND
  VETERAN
  ASSIST_MASTER
  FULL_ATTENDANCE_MONTH
}

enum SeasonType {
  LEAGUE
  CUP
  TOURNAMENT
}

enum SeasonStatus {
  ACTIVE
  FINISHED
}

enum TeamFieldType {
  GRASS
  SYNTHETIC
  FUTSAL
  SOCIETY
  OTHER
}

enum TeamCompetitiveLevel {
  CASUAL
  INTERMEDIATE
  COMPETITIVE
}

enum OpenMatchSlotStatus {
  OPEN
  BOOKED
  CLOSED
}

enum MatchLiveStatus {
  NOT_STARTED
  FIRST_HALF
  HALF_TIME
  SECOND_HALF
  FINISHED
}

enum LiveEventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
}

// ─── Models ───────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(PLAYER)
  mustChangePassword Boolean  @default(false)
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  playerId     String?  @unique
  player       Player?  @relation(fields: [playerId], references: [id])
  pushSubscriptions PushSubscription[]
  writtenEvaluations PlayerEvaluation[]
  givenRatings     MatchPlayerRating[]
  messages         TeamMessage[]
  messageReactions TeamMessageReaction[]
  notifications    Notification[]
  photos           MatchPhoto[]
  tacticalPlays    TacticalPlay[]
  activityEvents   ActivityEvent[]
  notificationPreferences NotificationPreference[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teamId])
  @@map("users")
}

model Team {
  id               String              @id @default(cuid())
  name             String
  shortName        String?
  slug             String              @unique
  badgeUrl         String?
  description      String?
  primaryColor     String?
  secondaryColor   String?
  defaultVenue     String?
  city             String?
  region           String?
  fieldType        TeamFieldType?
  competitiveLevel TeamCompetitiveLevel?
  publicDirectoryOptIn Boolean         @default(false)
  foundedYear      Int?
  kitHomeUrl       String?
  kitAwayUrl       String?
  kitGkUrl         String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  users            User[]
  players          Player[]
  matches          Match[]
  friendlyRequests FriendlyRequest[]
  transactions     Transaction[]
  inviteTokens     InviteToken[]
  membershipPayments MembershipPayment[]
  matchPayments    MatchPayment[]
  seasons          Season[]
  monthlyFeesEnabled Boolean         @default(true)
  openMatchSlots   OpenMatchSlot[]
  rules            Rule[]
  fines            Fine[]
  punishmentTypes  PunishmentType[]
  punishmentAccumulationRules PunishmentAccumulationRule[]
  evaluations      PlayerEvaluation[]
  equipments       Equipment[]
  equipmentOrders  EquipmentOrder[]
  messages         TeamMessage[]
  datePolls        DatePoll[]
  photos           MatchPhoto[]
  recruitmentRequests RecruitmentRequest[]
  guestPlayers       GuestPlayer[]
  tacticalPlays      TacticalPlay[]
  activityEvents     ActivityEvent[]
  notifications      Notification[]

  defaultFormation   MatchLineupFormation?
  defaultBlockPreset MatchLineupBlockPreset?
  defaultLineup      DefaultLineupSelection[]

  defaultPositionLimitsEnabled Boolean @default(false)
  defaultPositionLimits        Json?

  @@map("teams")
}

model Player {
  id           String         @id @default(cuid())
  name         String
  fullName     String?
  cpf          String?
  position          PlayerPosition
  secondaryPosition PlayerPosition?
  shirtNumber  Int
  photoUrl     String?
  age          Int?
  phone        String?
  description  String?
  status       PlayerStatus   @default(ACTIVE)
  teamId       String
  team         Team           @relation(fields: [teamId], references: [id])
  user         User?
  rsvps        RSVP[]
  availabilityRules PlayerAvailabilityRule[]
  attendances  MatchAttendance[]
  lineupSelections MatchLineupSelection[]
  defaultLineupSelections DefaultLineupSelection[]
  matchStats   MatchStats[]
  inviteTokens InviteToken[]
  membershipPayments MembershipPayment[]
  matchPayments MatchPayment[]
  achievements Achievement[]
  fines        Fine[]
  evaluations  PlayerEvaluation[]
  receivedRatings MatchPlayerRating[]
  pollVotes    DatePollVote[]
  liveEvents   MatchLiveEvent[]
  rsvpStatusLogs RSVPStatusLog[]
  votesGiven    MatchVote[] @relation("votesGiven")
  votesReceived MatchVote[] @relation("votesReceived")
  coachedMatches Match[] @relation("MatchCoach")
  coachReports   MatchCoachReport[] @relation("CoachPlayer")
  coachEvaluations MatchCoachEvaluation[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([teamId, shirtNumber])
  @@index([teamId, status])
  @@map("players")
}

model PlayerAvailabilityRule {
  id           String                @id @default(cuid())
  playerId     String
  player       Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startMinutes Int
  endMinutes   Int
  frequency    AvailabilityFrequency
  availability AvailabilityLevel
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([playerId])
  @@index([playerId, dayOfWeek])
  @@map("player_availability_rules")
}

model Match {
  id         String      @id @default(cuid())
  date       DateTime
  venue      String
  opponent   String
  opponentBadgeUrl String?
  type       MatchType
  homeScore  Int?
  awayScore  Int?
  isHome     Boolean     @default(true)
  status     MatchStatus @default(SCHEDULED)
  lineupFormation MatchLineupFormation?
  lineupBlockPreset MatchLineupBlockPreset?
  shareToken String      @unique @default(uuid())
  teamId     String
  team       Team        @relation(fields: [teamId], references: [id])
  rsvps      RSVP[]
  checklistItems MatchChecklistItem[]
  attendances MatchAttendance[]
  lineupSelections MatchLineupSelection[]
  matchStats MatchStats[]
  transactions Transaction[]
  positionLimits MatchPositionLimit[]
  seasonId   String?
  season     Season?     @relation(fields: [seasonId], references: [id])
  achievements Achievement[]
  hasCharge    Boolean     @default(false)
  chargeAmount Decimal?    @db.Decimal(10, 2)
  requiresDocumentDetails Boolean @default(false)
  pixKey       String?
  latitude     Float?
  longitude    Float?
  matchPayments MatchPayment[]
  datePoll     DatePoll?
  photos       MatchPhoto[]
  playerRatings MatchPlayerRating[]
  matchLive    MatchLive?
  guestPlayers GuestPlayer[]
  matchEquipments MatchEquipment[]
  suspensions  Fine[]      @relation("MatchSuspensions")
  rsvpStatusLogs RSVPStatusLog[]
  votes        MatchVote[]
  coachPlayerId String?
  coachPlayer   Player?                 @relation("MatchCoach", fields: [coachPlayerId], references: [id], onDelete: SetNull)
  coachReport   MatchCoachReport?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([teamId])
  @@index([seasonId])
  @@index([coachPlayerId])
  @@index([teamId, status])
  @@index([teamId, date])
  @@map("matches")
}

model MatchLineupSelection {
  id            String          @id @default(cuid())
  matchId       String
  playerId      String?
  guestPlayerId String?
  role          MatchLineupRole
  sortOrder     Int
  fieldX        Int?
  fieldY        Int?
  match         Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player        Player?         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  guestPlayer   GuestPlayer?    @relation(fields: [guestPlayerId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([matchId, playerId])
  @@unique([matchId, guestPlayerId])
  @@index([matchId, role, sortOrder])
  @@index([playerId])
  @@index([guestPlayerId])
  @@map("match_lineup_selections")
}

model MatchPositionLimit {
  id         String         @id @default(cuid())
  matchId    String
  match      Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  position   PlayerPosition
  maxPlayers Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt

  @@unique([matchId, position])
  @@index([matchId])
  @@map("match_position_limits")
}

model RSVP {
  id          String          @id @default(cuid())
  status      RSVPStatus      @default(PENDING)
  playerId    String
  player      Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchId     String
  match       Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  respondedAt DateTime?
  summoned    Boolean         @default(true)
  statusLogs  RSVPStatusLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@unique([playerId, matchId])
  @@index([matchId])
  @@index([matchId, status])
  @@map("rsvps")
}

model RSVPStatusLog {
  id         String      @id @default(cuid())
  rsvpId     String
  rsvp       RSVP        @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchId    String
  match      Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  oldStatus  RSVPStatus?
  newStatus  RSVPStatus
  createdAt  DateTime    @default(now())

  @@index([rsvpId])
  @@index([playerId])
  @@index([matchId])
  @@map("rsvp_status_logs")
}

model MatchStats {
  id          String   @id @default(cuid())
  goals       Int      @default(0)
  assists     Int      @default(0)
  yellowCards Int      @default(0)
  redCards      Int          @default(0)
  guestPlayerId String?
  guestPlayer   GuestPlayer? @relation(fields: [guestPlayerId], references: [id], onDelete: SetNull)
  playerId      String?
  player        Player?      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchId       String
  match         Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@unique([playerId, matchId, guestPlayerId])
  @@index([matchId])
  @@index([playerId])
  @@index([guestPlayerId])
  @@map("match_stats")
}

model FriendlyRequest {
  id                String                @id @default(cuid())
  requesterTeamName String
  contactEmail      String
  contactPhone      String?
  suggestedDates    String
  suggestedVenue    String?
  proposedFee       Decimal?              @db.Decimal(10, 2)
  status            FriendlyRequestStatus @default(PENDING)
  rejectionReason   String?
  teamId            String
  team              Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([teamId])
  @@index([teamId, status])
  @@map("friendly_requests")
}

model OpenMatchSlot {
  id         String              @id @default(cuid())
  teamId     String
  date       DateTime
  timeLabel  String?
  venueLabel String?
  notes      String?
  status     OpenMatchSlotStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  team       Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([status, date])
  @@map("open_match_slots")
}

model Transaction {
  id          String              @id @default(cuid())
  type        TransactionType
  amount      Decimal             @db.Decimal(10, 2)
  description String
  category    TransactionCategory
  date        DateTime
  status      TransactionStatus   @default(PAID)
  externalId  String?             @unique
  teamId      String
  matchId     String?
  team        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  match       Match?              @relation(fields: [matchId], references: [id], onDelete: SetNull)
  membershipPayment MembershipPayment?
  matchPayment MatchPayment?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([teamId])
  @@index([matchId])
  @@index([teamId, date])
  @@map("transactions")
}

model MatchChecklistItem {
  id        String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  label      String
  isChecked  Boolean  @default(false)
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([matchId, sortOrder])
  @@map("match_checklist_items")
}

model MatchAttendance {
  id          String   @id @default(cuid())
  matchId      String
  playerId     String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  present      Boolean  @default(false)
  checkedInAt  DateTime?
  shirtNumber  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
  @@map("match_attendances")
}

model InviteToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(uuid())
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([teamId])
  @@index([playerId])
  @@map("invite_tokens")
}

model MembershipPayment {
  id            String       @id @default(cuid())
  playerId      String
  teamId        String
  month         Int
  year          Int
  amount        Decimal      @db.Decimal(10, 2)
  paidAt        DateTime     @default(now())
  transactionId String?      @unique
  player        Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  updatedAt     DateTime     @default(now()) @updatedAt

  @@unique([playerId, month, year])
  @@index([teamId])
  @@index([playerId, teamId])
  @@index([year, month])
  @@map("membership_payments")
}

model MatchPayment {
  id            String       @id @default(cuid())
  playerId      String
  matchId       String
  teamId        String
  amount        Decimal      @db.Decimal(10, 2)
  paidAt        DateTime     @default(now())
  transactionId String?      @unique
  status        String       @default("PAID")
  receiptUrl    String?
  player        Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match         Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@unique([playerId, matchId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
  @@map("match_payments")
}

model Achievement {
  id        String          @id @default(cuid())
  playerId  String
  type      AchievementType
  matchId   String?
  awardedAt DateTime        @default(now())
  player    Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match     Match?          @relation(fields: [matchId], references: [id], onDelete: SetNull)
  updatedAt DateTime        @default(now()) @updatedAt

  @@unique([playerId, type, matchId])
  @@index([playerId])
  @@index([matchId])
  @@map("achievements")
}

model Season {
  id        String       @id @default(cuid())
  teamId    String
  name      String
  type      SeasonType
  startDate DateTime
  endDate   DateTime?
  status    SeasonStatus @default(ACTIVE)
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matches   Match[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([teamId])
  @@index([teamId, status])
  @@map("seasons")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Rule {
  id             String   @id @default(cuid())
  title          String
  description    String
  severity       String   @default("WARNING") // WARNING (Advertência) or SUSPENSION (Suspensão)
  defaultMatches Int?     // Número de jogos de suspensão padrão se for suspensão
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fines          Fine[]
  punishmentTypeId String?
  punishmentType   PunishmentType? @relation(fields: [punishmentTypeId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([teamId])
  @@map("rules")
}

model Fine {
  id               String    @id @default(cuid())
  playerId         String
  player           Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ruleId           String?
  rule             Rule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  description      String
  severity         String    @default("WARNING") // WARNING (Advertência) or SUSPENSION (Suspensão)
  matchesSuspended Int?      // Quantidade de jogos de suspensão
  status           String    @default("ACTIVE")  // ACTIVE (Ativa/Pendente), SERVED (Cumprida/Cumprido), CANCELLED (Cancelada)
  date             DateTime
  teamId           String
  team             Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  punishmentTypeId String?
  punishmentType   PunishmentType? @relation(fields: [punishmentTypeId], references: [id], onDelete: SetNull)
  suspendedMatchId String?
  suspendedMatch   Match?    @relation("MatchSuspensions", fields: [suspendedMatchId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([teamId])
  @@index([playerId])
  @@index([ruleId])
  @@index([suspendedMatchId])
  @@index([teamId, status])
  @@index([playerId, status])
  @@map("fines")
}

model PlayerEvaluation {
  id             String   @id @default(cuid())
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  evaluatorId    String
  evaluator      User     @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  content        String   @db.Text
  
  // Notas quantitativas (1 a 5)
  technical      Int      @default(3)
  tactical       Int      @default(3)
  physical       Int      @default(3)
  discipline     Int      @default(3)
  
  date           DateTime @default(now())
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([playerId])
  @@index([evaluatorId])
  @@index([teamId])
  @@map("player_evaluations")
}

model MatchPlayerRating {
  id             String       @id @default(cuid())
  matchId        String
  match          Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raterId        String       // ID do User que avaliou
  rater          User         @relation(fields: [raterId], references: [id], onDelete: Cascade)
  ratedId        String?      // ID do Player avaliado
  rated          Player?      @relation(fields: [ratedId], references: [id], onDelete: Cascade)
  ratedGuestId   String?      // ID do GuestPlayer avaliado
  ratedGuest     GuestPlayer? @relation(fields: [ratedGuestId], references: [id], onDelete: Cascade)
  stars          Int          // 1 a 5 estrelas
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([matchId, raterId, ratedId])
  @@unique([matchId, raterId, ratedGuestId])
  @@index([matchId])
  @@index([raterId])
  @@index([ratedId])
  @@index([ratedGuestId])
  @@map("match_player_ratings")
}

model Equipment {
  id           String   @id @default(cuid())
  name         String
  category     String   // UNIFORM, SOCKS, BALL, OTHER
  totalQty     Int      @default(0)
  availableQty Int      @default(0)
  minQty       Int      @default(0)
  damagedQty   Int      @default(0)
  lostQty      Int      @default(0)
  status       String   @default("GOOD") // NEW, GOOD, USED, POOR
  location     String?  
  notes        String?  @db.Text
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchEquipments MatchEquipment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teamId])
  @@index([category])
  @@map("equipments")
}

model EquipmentOrder {
  id            String    @id @default(cuid())
  name          String
  category      String    // UNIFORM, SOCKS, BALL, OTHER
  quantity      Int       @default(1)
  status        String    @default("PENDING") // PENDING, ORDERED, RECEIVED, CANCELLED
  notes         String?   @db.Text
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([teamId])
  @@index([status])
  @@map("equipment_orders")
}

model TeamMessage {
  id        String   @id @default(cuid())
  teamId    String
  authorId  String
  content   String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions TeamMessageReaction[]

  @@index([teamId])
  @@index([teamId, pinned])
  @@index([teamId, createdAt])
  @@map("team_messages")
}

model TeamMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("team_message_reactions")
}

model DatePoll {
  id        String           @id @default(cuid())
  teamId    String
  matchId   String?          @unique
  title     String
  closedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  match     Match?           @relation(fields: [matchId], references: [id], onDelete: SetNull)
  options   DatePollOption[]

  @@index([teamId])
  @@map("date_polls")
}

model DatePollOption {
  id        String          @id @default(cuid())
  pollId    String
  date      DateTime
  label     String?
  createdAt DateTime        @default(now())
  poll      DatePoll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     DatePollVote[]

  @@index([pollId])
  @@map("date_poll_options")
}

model DatePollVote {
  id       String         @id @default(cuid())
  optionId String
  playerId String
  createdAt DateTime      @default(now())
  option   DatePollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  player   Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([optionId, playerId])
  @@index([optionId])
  @@map("date_poll_votes")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  teamId    String?
  type      String   // MATCH_CREATED, FINE_APPLIED, PAYMENT_DUE, MESSAGE_PINNED, RSVP_REMINDER, RECAP_READY
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  readAt    DateTime?
  metadata  Json?
  entityType String?
  entityId   String?
  category   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([teamId])
  @@map("notifications")
}

model MatchPhoto {
  id           String   @id @default(cuid())
  matchId      String?
  teamId       String
  url          String
  caption      String?
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  match        Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([matchId])
  @@index([teamId, createdAt])
  @@map("match_photos")
}

model RecruitmentRequest {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  contact   String
  position  String?
  message   String?  @db.Text
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("recruitment_requests")
}

model DefaultLineupSelection {
  id         String          @id @default(cuid())
  teamId     String
  playerId   String
  role       MatchLineupRole @default(STARTER)
  sortOrder  Int
  fieldX     Int?
  fieldY     Int?
  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player     Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([teamId, playerId])
  @@index([teamId, role, sortOrder])
  @@index([playerId])
  @@map("default_lineup_selections")
}

model PunishmentType {
  id                  String                      @id @default(cuid())
  name                String                      // Nome da punição (ex: "Advertência", "Suspensão", "Multa de R$ 50")
  description         String?
  severity            String                      @default("WARNING") // WARNING ou SUSPENSION (para compatibilidade retroativa)
  teamId              String
  team                Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rules               Rule[]
  fines               Fine[]
  
  // Relações com as regras de acúmulo
  sourceAccumulations PunishmentAccumulationRule[] @relation("SourceAccumulation")
  targetAccumulations PunishmentAccumulationRule[] @relation("TargetAccumulation")

  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([teamId, name])
  @@index([teamId])
  @@map("punishment_types")
}

model PunishmentAccumulationRule {
  id              String         @id @default(cuid())
  teamId          String
  team            Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  sourceTypeId    String
  sourceType      PunishmentType @relation("SourceAccumulation", fields: [sourceTypeId], references: [id], onDelete: Cascade)
  
  accumulateCount Int            // Quantidade acumulada para acionar (ex: 3)
  
  targetTypeId    String
  targetType      PunishmentType @relation("TargetAccumulation", fields: [targetTypeId], references: [id], onDelete: Cascade)
  
  targetMatches   Int?           // Qtd de jogos suspensos caso o tipo de destino seja de suspensão (ex: 1)
  expiryDays      Int?           // Janela de expiração em dias (ex: 30), nulo se nunca expirar
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([teamId, sourceTypeId])
  @@index([teamId])
  @@map("punishment_accumulation_rules")
}

model MatchLive {
  id              String          @id @default(cuid())
  matchId         String          @unique
  match           Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  liveStatus      MatchLiveStatus @default(NOT_STARTED)
  homeScore       Int             @default(0)
  awayScore       Int             @default(0)
  firstHalfStart  DateTime?
  firstHalfEnd    DateTime?
  secondHalfStart DateTime?
  secondHalfEnd   DateTime?
  events          MatchLiveEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([matchId])
  @@map("match_lives")
}

model MatchLiveEvent {
  id            String        @id @default(cuid())
  matchLiveId   String
  matchLive     MatchLive     @relation(fields: [matchLiveId], references: [id], onDelete: Cascade)
  type          LiveEventType
  minute        Int
  half          Int           // 1 ou 2
  playerId      String?
  player        Player?       @relation(fields: [playerId], references: [id], onDelete: SetNull)
  guestPlayerId String?
  guestPlayer   GuestPlayer?  @relation(fields: [guestPlayerId], references: [id], onDelete: SetNull)
  description   String?
  createdAt     DateTime      @default(now())

  @@index([matchLiveId])
  @@index([playerId])
  @@index([guestPlayerId])
  @@map("match_live_events")
}

model GuestPlayer {
  id          String           @id @default(cuid())
  name        String
  shirtNumber Int?
  position    PlayerPosition?
  matchId     String
  match       Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  liveEvents  MatchLiveEvent[]
  matchStats  MatchStats[]
  lineupSelections MatchLineupSelection[]
  receivedRatings MatchPlayerRating[]
  coachEvaluations MatchCoachEvaluation[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([matchId, name])
  @@index([matchId])
  @@index([teamId])
  @@map("guest_players")
}

model MatchEquipment {
  id               String     @id @default(cuid())
  matchId          String
  match            Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  equipmentId      String?
  equipment        Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  name             String
  quantitySent     Int        @default(0)
  quantityReturned Int        @default(0)
  returned         Boolean    @default(false)
  notes            String?    @db.Text
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([matchId])
  @@index([equipmentId])
  @@map("match_equipments")
}

// ─── Match Voting ──────────────────────────────────────────

model MatchVote {
  id        String   @id @default(cuid())
  matchId   String
  voterId   String
  votedId   String
  createdAt DateTime @default(now())

  match Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  voter Player @relation("votesGiven", fields: [voterId], references: [id], onDelete: Cascade)
  voted Player @relation("votesReceived", fields: [votedId], references: [id], onDelete: Cascade)

  @@unique([matchId, voterId])
  @@index([matchId])
  @@index([votedId])
  @@map("match_votes")
}

// ─── Tactical Plays ────────────────────────────────────────

model TacticalPlay {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("CORNER_KICK")
  movements   Json
  teamId      String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("tactical_plays")
}

// ─── Activity Events ────────────────────────────────────────

model ActivityEvent {
  id          String   @id @default(cuid())
  teamId      String
  userId      String?
  type        String   // MATCH_CREATED, PLAYER_ADDED, TRANSACTION_LOGGED, POLL_CREATED, etc.
  description String
  metadata    Json?    // Dynamic variables
  createdAt   DateTime @default(now())

  team        Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([teamId, createdAt])
  @@map("activity_events")
}

// ─── Notification Preferences ─────────────────────────────────

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  category  String   // MATCHES, FINANCES, DISCIPLINARY, COMMUNICATION
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("notification_preferences")
}

// ─── Relatório do Treinador & Avaliações ───────────────────────────

model MatchCoachReport {
  id                 String                  @id @default(cuid())
  matchId            String                  @unique
  match              Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  coachPlayerId      String?
  coachPlayer        Player?                 @relation("CoachPlayer", fields: [coachPlayerId], references: [id], onDelete: SetNull)
  summary            String?                 @db.Text
  startingStrategy   String?                 @db.Text
  substitutionsNotes String?                 @db.Text
  strengths          String?                 @db.Text
  improvements       String?                 @db.Text
  status             String                  @default("DRAFT") // DRAFT, PUBLISHED
  evaluations        MatchCoachEvaluation[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([coachPlayerId])
  @@map("match_coach_reports")
}

model MatchCoachEvaluation {
  id            String            @id @default(cuid())
  reportId      String
  report        MatchCoachReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  playerId      String?
  player        Player?           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  guestPlayerId String?
  guestPlayer   GuestPlayer?      @relation(fields: [guestPlayerId], references: [id], onDelete: Cascade)
  rating        Int               @default(5) // 1 a 10
  feedback      String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([reportId, playerId])
  @@unique([reportId, guestPlayerId])
  @@index([reportId])
  @@index([playerId])
  @@index([guestPlayerId])
  @@map("match_coach_evaluations")
}

