# Database
# Transaction pooler (porta 6543) – usado pelo Prisma em runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta (porta 5432) – usada pelo Prisma para migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# Admin Setup Code
ADMIN_REGISTRATION_CODE="change-me-to-a-secret-code"

# Webhook Secrets
WEBHOOK_PIX_SECRET="change-me-to-pix-webhook-secret"

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa..."
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_SUBJECT="mailto:contato@sitetime.com.br"

# Distributed Rate Limiting (Optional - Upstash Redis)
UPSTASH_REDIS_REST_URL="https://xxxxxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email Provider: resend | brevo (opcional; autodetecta se omitido)
EMAIL_PROVIDER="resend"

# Resend config
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Brevo config (alternativa quando domínio próprio não está configurado)
BREVO_API_KEY="xkeysib-xxxxxxxx"
BREVO_SENDER_EMAIL="seu-email@exemplo.com"
BREVO_SENDER_NAME="Site Time"

# Supabase Storage (S3-compatible endpoint)
SUPABASE_STORAGE_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
SUPABASE_STORAGE_BUCKET="uploads"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
